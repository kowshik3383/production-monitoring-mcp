# ==============================================================================
# PRODUCTION OBSERVABILITY MCP CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in the credentials for the services you use.
# All tools gracefully inform the agent if a specific service is unconfigured.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SENTRY (Error Tracking, Stack Traces, Regressions)
# Scope needed: 'project:read', 'event:read', 'org:read'
# Generate at: https://sentry.io/settings/account/api/auth-tokens/
# ------------------------------------------------------------------------------
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-default-project-slug
SENTRY_HOST=https://sentry.io

# ------------------------------------------------------------------------------
# 2. GITHUB (Commits, Diff Comparisons, PRs, Deployments)
# Scope needed: Fine-grained token with 'Contents: Read-only' and 'Deployments: Read-only'
# Or classic token with 'repo' scope
# Generate at: https://github.com/settings/tokens
# ------------------------------------------------------------------------------
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=your-github-org-or-username
GITHUB_REPO=your-github-repo-name

# ------------------------------------------------------------------------------
# 3. VERCEL (Production & Preview Deployments, Build/Runtime Logs)
# Scope needed: Read-only Personal Access Token
# Generate at: https://vercel.com/account/tokens
# ------------------------------------------------------------------------------
VERCEL_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
VERCEL_TEAM_ID=team_xxxxxxxxxxxxxxxxxxxx
VERCEL_PROJECT_ID=prj_xxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 4. BETTER STACK (Uptime Monitors, Downtime Incidents, Application Logs)
# Uptime API Token: https://uptime.betterstack.com/team/tokens
# Logs Token (Logtail): https://logs.betterstack.com/sources
# ------------------------------------------------------------------------------
BETTERSTACK_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
BETTERSTACK_LOGS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 5. CLOUDFLARE (Edge HTTP Analytics, Latency, Status Codes 2xx/4xx/5xx)
# Scope needed: 'Analytics: Read'
# Generate at: https://dash.cloudflare.com/profile/api-tokens
# ------------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_ZONE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
